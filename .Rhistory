# behavior test: run the full model and plot daily dry matter intake for n_plot agents
plot_daily_dmi <- function(forage_reference, dem, canopy, escape, n_plot = 10) {
# ----------------------------------------------------------------------------------------------------------------------
# run the full model
# ----------------------------------------------------------------------------------------------------------------------
#1) run ncc_abm end to end; agents is a named list of per-agent hourly tibbles
result <- ncc_abm(
forage_reference,
dem,
canopy,
escape
)
agents <- result$agents
# ----------------------------------------------------------------------------------------------------------------------
# daily dry matter intake
# ----------------------------------------------------------------------------------------------------------------------
#1) keep the first n_plot agents
agents <- agents[seq_len(min(n_plot, length(agents)))]
#2) sum the hourly forage_consumed (g) within each 24-hour day to get daily DMI (g/day).
#   a day index from the row position matches the model's day blocks. a day on which an
#   agent is dead has all-NA rows and returns NA, so its line ends rather than dropping
#   to zero
daily_dmi <- function(a) {
day <- ((seq_len(nrow(a)) - 1) %/% 24) + 1
tapply(
a$forage_consumed,
day,
function(v) if (all(is.na(v))) NA_real_ else sum(v, na.rm = TRUE)
)
}
#3) stack the per-agent series into one long data frame, ordered by agent id
dmi <- do.call(rbind, lapply(names(agents), function(id) {
series <- daily_dmi(agents[[id]])
data.frame(day = as.integer(names(series)), dmi = as.numeric(series), id = id)
}))
dmi$id <- factor(dmi$id, levels = names(agents))
# ----------------------------------------------------------------------------------------------------------------------
# plot
# ----------------------------------------------------------------------------------------------------------------------
#1) one line per agent, styled like plot_abm
ggplot(dmi, aes(day, dmi, color = id)) +
geom_line(linewidth = 0.8, na.rm = TRUE) +
scale_color_viridis_d(name = "Agent") +
labs(
title = "Daily dry matter intake",
x = "Day",
y = "DMI (g/day)"
) +
theme_martin(base_size = 14)
}
agents <- result$agents
agent_params <- result$agent_params
#   escape
# )
# agents <- result$agents
#
# # ----------------------------------------------------------------------------------------------------------------------
# # daily dry matter intake
# # ----------------------------------------------------------------------------------------------------------------------
#
# #1) keep the first n_plot agents
#
agents <- agents[seq_len(min(n_plot, length(agents)))]
# behavior test: run the full model and plot daily dry matter intake for n_plot agents
plot_daily_dmi <- function(forage_reference, dem, canopy, escape, n_plot = 10) {
# ----------------------------------------------------------------------------------------------------------------------
# run the full model
# ----------------------------------------------------------------------------------------------------------------------
# #1) run ncc_abm end to end; agents is a named list of per-agent hourly tibbles
#
# result <- ncc_abm(
#   forage_reference,
#   dem,
#   canopy,
#   escape
# )
# agents <- result$agents
#
# # ----------------------------------------------------------------------------------------------------------------------
# # daily dry matter intake
# # ----------------------------------------------------------------------------------------------------------------------
#
# #1) keep the first n_plot agents
#
agents <- agents[seq_len(min(n_plot, length(agents)))]
#2) sum the hourly forage_consumed (g) within each 24-hour day to get daily DMI (g/day).
#   a day index from the row position matches the model's day blocks. a day on which an
#   agent is dead has all-NA rows and returns NA, so its line ends rather than dropping
#   to zero
daily_dmi <- function(a) {
day <- ((seq_len(nrow(a)) - 1) %/% 24) + 1
tapply(
a$forage_consumed,
day,
function(v) if (all(is.na(v))) NA_real_ else sum(v, na.rm = TRUE)
)
}
#3) stack the per-agent series into one long data frame, ordered by agent id
dmi <- do.call(rbind, lapply(names(agents), function(id) {
series <- daily_dmi(agents[[id]])
data.frame(day = as.integer(names(series)), dmi = as.numeric(series), id = id)
}))
dmi$id <- factor(dmi$id, levels = names(agents))
# ----------------------------------------------------------------------------------------------------------------------
# plot
# ----------------------------------------------------------------------------------------------------------------------
#1) one line per agent, styled like plot_abm
ggplot(dmi, aes(day, dmi, color = id)) +
geom_line(linewidth = 0.8, na.rm = TRUE) +
scale_color_viridis_d(name = "Agent") +
labs(
title = "Daily dry matter intake",
x = "Day",
y = "DMI (g/day)"
) +
theme_martin(base_size = 14)
}
plot_dmi()
plot_abm(result, forage_reference[[1]])
hist(forage_reference[[123]])
plot(forage_reference[[123]])
