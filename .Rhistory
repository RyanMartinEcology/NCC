# configure and load rasters
# ------------------------------------------------------------------------------------------------------------------------
#1) simulation size
set_param('n_agents', 10L)
#2) load rasters
dem <- rast('~/Graduate School/Writing/Papers In Progress/Nutritional Carrying Capacity/Model Rasters/dem.tif')
canopy <- rast('~/Graduate School/Writing/Papers In Progress/Nutritional Carrying Capacity/Model Rasters/canopy.tif')
escape <- rast('~/Graduate School/Writing/Papers In Progress/Nutritional Carrying Capacity/Model Rasters/escape.tif')
forage_reference <- rast('~/Graduate School/Writing/Papers In Progress/Nutritional Carrying Capacity/Model Rasters/suitable_biomass_2023_per_cell.tif')
# ------------------------------------------------------------------------------------------------------------------------
# run the model
# ------------------------------------------------------------------------------------------------------------------------
#1) run with 20 agents and 25 candidates
result <- ncc_abm(
forage_reference,
dem,
canopy,
escape,
report_time = T
)
summary_abm(result)
plot_abm(result, forage_reference[[1]])
